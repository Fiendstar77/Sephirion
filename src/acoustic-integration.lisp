(in-package #:sephirion-acoustic)

(defun derivative (network state time)
  (let* ((nodes (acoustic-network-nodes network)) (n (length nodes))
         (out (make-array (+ (* 2 n) 2) :initial-element 0d0)))
    (loop for node across nodes for i from 0 for j = (* 2 i)
          for q = (aref state j) for v = (aref state (1+ j))
          for force = (force-at node time)
          do (setf (aref out j) v
                   (aref out (1+ j)) (- force (* (acoustic-realm-r node) v)
                                        (* (acoustic-realm-k node) q)))
             (incf (aref out (* 2 n)) (* force v))
             (incf (aref out (1+ (* 2 n))) (* (acoustic-realm-r node) v v)))
    (dolist (edge (acoustic-network-edges network))
      (destructuring-bind (i j stiffness) edge
        (let ((force (* stiffness (- (aref state (* 2 i)) (aref state (* 2 j))))))
          (decf (aref out (1+ (* 2 i))) force)
          (incf (aref out (1+ (* 2 j))) force))))
    (loop for node across nodes for i from 0
          do (setf (aref out (1+ (* 2 i)))
                   (/ (aref out (1+ (* 2 i))) (acoustic-realm-m node))))
    out))

(defun step-acoustic (network)
  "Synchronous classical RK4, including work/loss. The predecessor is untouched."
  (require-acoustic network)
  (handler-case
      (let* ((state (acoustic-network-state network))
             (dt (acoustic-network-dt network)) (half (/ dt 2d0))
             (tick (acoustic-network-tick network)) (time (* tick dt))
             (next-time (* (1+ tick) dt)))
        (unless (> next-time time) (invalid "Timestep no longer advances representable time."))
        (let* ((a (derivative network state time))
               (b (derivative network (sephirion::shifted-state state a half) (+ time half)))
               (c (derivative network (sephirion::shifted-state state b half) (+ time half)))
               (d (derivative network (sephirion::shifted-state state c dt) next-time))
               (next (map 'vector (lambda (x da db dc dd)
                                    (number-value (+ x (* (/ dt 6d0)
                                                         (+ da (* 2d0 db) (* 2d0 dc) dd)))))
                          state a b c d)))
          (%network :nodes (acoustic-network-nodes network) :edges (acoustic-network-edges network)
                    :state next :dt dt :tick (1+ tick)
                    :initial-energy (acoustic-network-initial-energy network))))
    (arithmetic-error (condition) (invalid "Acoustic integration arithmetic failure: ~A" condition))))

(defun run-acoustic (network steps)
  (require-acoustic network)
  (unless (and (integerp steps) (>= steps 0)) (invalid "Invalid acoustic step count."))
  (loop repeat steps do (setf network (step-acoustic network)) finally (return network)))

(defun csv-fields (stream fields)
  (loop for field in fields for first = t then nil
        do (unless first (write-char #\, stream))
           (if (stringp field)
               (progn (write-char #\" stream)
                      (loop for char across field do (write-char char stream)
                            when (char= char #\") do (write-char char stream))
                      (write-char #\" stream))
               (if (integerp field) (princ field stream)
                   (write-string (substitute #\e #\d (string-downcase (format nil "~,16E" field))) stream))))
  (terpri stream))

(defun write-trace-header (stream)
  (write-line "tick,time,realm,q,v,force,local_energy,allocated_energy,input_power,loss_power,total_energy,input_work,dissipated_energy,balance_residual" stream))

(defun write-trace-row (network stream)
  (let ((snapshot (acoustic-snapshot network)))
    (dolist (node (getf snapshot :realms))
      (csv-fields stream
                  (append (list (getf snapshot :tick) (getf snapshot :time) (getf node :id))
                          (loop for key in '(:q :v :force :local-energy :energy :input-power :loss-power)
                                collect (getf node key))
                          (loop for key in '(:energy :work :dissipation :residual)
                                collect (getf snapshot key)))))))
