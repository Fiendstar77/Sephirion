(in-package #:sephirion-acoustic)

(defun measure-acoustic-response (factory omega &key (settle-time 400d0) (cycles 8)
                                                   (max-dt 0.02d0) trace-stream (trace-stride 10))
  "FACTORY accepts dt and returns fresh initial-rest realms driven at OMEGA.
The factory defines the experiment, not a callback used inside physical stepping."
  (setf omega (number-value omega :positive t)
        max-dt (number-value max-dt :positive t)
        settle-time (number-value settle-time :nonnegative t))
  (unless (and (integerp cycles) (> cycles 0) (integerp trace-stride) (> trace-stride 0))
    (invalid "Cycles and trace stride must be positive integers."))
  (let* ((period (/ (* 2d0 pi) omega)) (per-cycle (max 32 (ceiling period max-dt)))
         (dt (/ period per-cycle)) (settle (ceiling settle-time dt))
         (samples (* cycles per-cycle)) (steps (+ settle samples))
         (network (funcall factory dt))
         (nodes (acoustic-network-nodes (require-acoustic network)))
         (n (length nodes)) (sums (make-array n :initial-element #c(0d0 0d0)))
         (energies (make-array n :initial-element 0d0))
         (max-residual 0d0) (scaled-residual 0d0))
    (unless (and (zerop (acoustic-network-tick network)) (= (acoustic-network-dt network) dt)
                 (every #'zerop (acoustic-network-state network))
                 (every (lambda (node) (= omega (acoustic-realm-omega node))) nodes))
      (invalid "Measurement factory must return an initial-rest network with the requested dt and frequency."))
    (when trace-stream (write-trace-header trace-stream) (write-trace-row network trace-stream))
    (loop for tick from 1 to steps
          do (setf network (step-acoustic network))
             (let* ((state (acoustic-network-state network))
                    (total (nth-value 2 (energy-parts network state)))
                    (work (aref state (* 2 n))) (loss (aref state (1+ (* 2 n))))
                    (residual (+ (- total (acoustic-network-initial-energy network) work) loss)))
               (setf max-residual (max max-residual (abs residual))
                     scaled-residual (max scaled-residual
                                          (/ (abs residual) (+ 1d0 (acoustic-network-initial-energy network)
                                                                (abs work) loss))))
               (when (> tick settle)
                 (let ((basis (cis (- (* omega tick dt))))
                       (allocated (nth-value 1 (energy-parts network state))))
                   (dotimes (i n)
                     (incf (aref sums i) (* (aref state (* 2 i)) basis))
                     (incf (aref energies i) (aref allocated i))))))
             (when (and trace-stream (or (zerop (mod tick trace-stride)) (= tick steps)))
               (write-trace-row network trace-stream)))
    (list :responses (map 'vector (lambda (sum) (* (/ 2d0 samples) sum)) sums)
          :mean-energies (map 'vector (lambda (sum) (/ sum samples)) energies)
          :dt dt :steps steps :sample-count samples
          :max-residual max-residual :scaled-residual scaled-residual
          :final (acoustic-snapshot network))))
