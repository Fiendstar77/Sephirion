;; Integrity checks for the fixed experiment's CSV dialect (no commas inside labels).
;; Uses only standard Common Lisp and SBCL's bundled ASDF/UIOP.
(require :asdf)
(let* ((directory (uiop:pathname-directory-pathname *load-truename*))
       (*read-eval* nil) (*read-default-float-format* 'double-float))
  (labels ((rows (name)
             (with-open-file (stream (merge-pathnames name directory))
               (read-line stream)
               (loop for line = (read-line stream nil) while line
                     collect (mapcar #'read-from-string (uiop:split-string line :separator ",")))))
           (close-enough (a b)
             (< (abs (- a b)) (* 1d-12 (+ 1d0 (abs a) (abs b))))))
    (let* ((responses (rows "responses.csv"))
           (peaks (rows "peaks.csv")) (transfers (rows "transfer-summary.csv"))
           (trace-count 0))
      (assert (= (length responses) 558))
      (assert (= (length transfers) 3))
      (dolist (row responses)
        (assert (= (length row) 20))
        (loop for value in row for i from 0
              unless (member i '(0 2)) do (assert (realp value)))
        (assert (< (nth 7 row) 5d-6))
        (assert (< (nth 19 row) 1d-6))
        ;; Driven sweeps start from rest, so E0=0.
        (assert (<= (abs (+ (- (nth 15 row) (nth 16 row)) (nth 17 row)))
                    (+ (nth 18 row) 1d-10)))
        (when (and (string= (first row) "pair-off") (string= (third row) "b"))
          (assert (zerop (nth 3 row))))
        (when (string= (first row) "chain-nested")
          (let ((flat (find-if (lambda (other) (and (string= (first other) "chain-flat")
                                                   (= (second row) (second other))
                                                   (string= (third row) (third other)))) responses)))
            (assert flat)
            (assert (equalp (rest row) (rest flat))))))
      (dolist (entry '(("nested-chain-trace.csv" 3 0d0)
                       ("transfer-0.0.csv" 2 0.5d0)
                       ("transfer-0.1.csv" 2 0.55d0)
                       ("transfer-0.5.csv" 2 0.75d0)))
        (destructuring-bind (name node-count initial-energy) entry
          (let ((data (rows name)) (last-tick -1))
            (incf trace-count (length data))
            (assert (zerop (mod (length data) node-count)))
            (loop for group on data by (lambda (tail) (nthcdr node-count tail))
                  for tick = (first (first group))
                  do (assert (> tick last-tick))
                     (setf last-tick tick)
                     (let ((allocated 0d0) (first (first group)))
                       (loop for row in group repeat node-count
                             do (assert (= (length row) 14))
                                (assert (= (first row) tick))
                                (loop for value in row for i from 0
                                      unless (= i 2) do (assert (realp value)))
                                (assert (>= (nth 9 row) 0d0))
                                (assert (>= (nth 6 row) 0d0))
                                (assert (>= (nth 7 row) 0d0))
                                (assert (close-enough (nth 13 row)
                                                      (+ (- (nth 10 row) initial-energy (nth 11 row))
                                                         (nth 12 row))))
                                (incf allocated (nth 7 row)))
                       (assert (close-enough allocated (nth 10 first))))))))
      (format t "CSV integrity: 558 response rows, ~D peak rows, 3 transfer summaries, ~D trace rows passed.~%"
              (length peaks) trace-count))))
