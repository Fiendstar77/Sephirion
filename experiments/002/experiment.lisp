(in-package #:sephirion-experiment-002)

(defparameter *pair-scenarios*
  '(("pair-reference" :coupling 0.5d0 :r 0.2d0 :k2 1d0)
    ("pair-off" :coupling 0d0 :enabled nil :r 0.2d0 :k2 1d0)
    ("pair-weak" :coupling 0.1d0 :r 0.2d0 :k2 1d0)
    ("pair-mismatch" :coupling 0.5d0 :r 0.2d0 :k2 2.25d0)
    ("pair-low-damping" :coupling 0.5d0 :r 0.1d0 :k2 1d0)
    ("pair-high-damping" :coupling 0.5d0 :r 0.5d0 :k2 1d0)))

(defun pair-reference (omega parameters)
  (let* ((r (getf parameters :r))
         (pair (sephirion:make-acoustic-pair
                :coupling (if (getf parameters :enabled t) (getf parameters :coupling) 0d0)
                :r1 r :r2 r :k2 (getf parameters :k2))))
    (multiple-value-bind (a b) (sephirion:analytical-response pair omega) (vector a b))))

(defun write-response (stream scenario omega result expected)
  (let* ((snapshot (getf result :final)) (responses (getf result :responses))
         (means (getf result :mean-energies)))
    (loop for node in (getf snapshot :realms) for i from 0
          for response = (aref responses i) for reference = (aref expected i)
          do (sephirion-acoustic::csv-fields
              stream
              (append (list scenario omega (getf node :id) (abs response) (phase response)
                            (abs reference) (phase reference) (abs (- response reference))
                            (aref means i) (getf node :q) (getf node :v)
                            (getf node :local-energy) (getf node :energy) (getf result :dt)
                            (getf snapshot :time) (getf snapshot :energy)
                            (getf snapshot :work) (getf snapshot :dissipation)
                            (getf result :max-residual) (getf result :scaled-residual)))))))

(defun write-peaks (stream scenario measurements)
  (dotimes (i (length (getf (cdar measurements) :responses)))
    (let* ((id (getf (nth i (getf (getf (cdar measurements) :final) :realms)) :id))
           (peak (reduce (lambda (a b)
                           (if (>= (abs (aref (getf (cdr a) :responses) i))
                                   (abs (aref (getf (cdr b) :responses) i))) a b)) measurements)))
      (labels ((write-one (entry kind)
                 (let ((response (aref (getf (cdr entry) :responses) i)))
                   (sephirion-acoustic::csv-fields
                    stream (list scenario id kind (car entry) (abs response) (phase response))))))
        (write-one peak "largest-sampled")
        (loop for (previous current next) on measurements while next
              when (and (> (abs (aref (getf (cdr current) :responses) i))
                           (abs (aref (getf (cdr previous) :responses) i)))
                        (> (abs (aref (getf (cdr current) :responses) i))
                           (abs (aref (getf (cdr next) :responses) i))))
                do (write-one current "interior-peak"))))))

(defun free-transfer (directory summary-stream validate)
  (dolist (stiffness '(0d0 0.1d0 0.5d0))
    (let* ((network (pair-network 0.02d0 0d0 :r 0d0 :driven nil :q1 1d0 :coupling stiffness))
           (initial (acoustic-energy network)) (max-fraction 0d0) (first-crossing nil)
           (max-drift 0d0)
           (filename (format nil "transfer-~,1F.csv" stiffness)))
      (with-open-file (stream (merge-pathnames filename directory) :direction :output :if-exists :supersede)
        (write-trace-header stream) (write-trace-row network stream)
        (loop for tick from 1 to 2000
              do (setf network (step-acoustic network))
                 (let* ((snapshot (acoustic-snapshot network))
                        (local (getf (second (getf snapshot :realms)) :local-energy))
                        (fraction (/ local initial)))
                   (setf max-drift (max max-drift (/ (abs (- (getf snapshot :energy) initial)) initial))
                         max-fraction (max max-fraction fraction))
                   (when (and (null first-crossing) (>= fraction 0.1d0))
                     (setf first-crossing (getf snapshot :time))))
                 (when (zerop (mod tick 10)) (write-trace-row network stream))))
      (sephirion-acoustic::csv-fields summary-stream
                                      (list stiffness initial max-fraction (or first-crossing "not-reached") max-drift))
      (funcall validate (format nil "free-transfer Kc=~A energy drift" stiffness) (< max-drift 1d-7))
      (funcall validate (format nil "free-transfer Kc=~A receiver excitation" stiffness)
               (if (zerop stiffness) (zerop max-fraction) (> max-fraction 0.1d0)))
      (format t "Free transfer Kc=~,1F: max receiver local-energy fraction=~,8F; first 10% crossing=~A; relative drift=~,6E~%"
              stiffness max-fraction (or first-crossing :not-reached) max-drift))))

(defun run-experiments (directory)
  (let* ((directory (uiop:ensure-directory-pathname directory))
         (passed 0) (failed 0) (*print-pretty* nil)
         (flat-results (make-hash-table))
         (max-nesting-difference 0d0))
    (ensure-directories-exist (merge-pathnames "responses.csv" directory))
    (labels ((validate (name ok)
               (if ok (incf passed)
                   (progn (incf failed) (format t "FAIL ~A~%" name)))))
      (format t "SEPHIRION-002 / Experiment 002~%OBSERVATIONS~%")
      (with-open-file (responses (merge-pathnames "responses.csv" directory) :direction :output :if-exists :supersede)
        (with-open-file (peaks (merge-pathnames "peaks.csv" directory) :direction :output :if-exists :supersede)
          (write-line "scenario,omega,realm,amplitude,phase,analytical_amplitude,analytical_phase,complex_error,mean_allocated_energy,q_end,v_end,local_energy_end,allocated_energy_end,dt,time_end,total_energy_end,input_work,dissipated_energy,max_balance_residual,max_scaled_residual" responses)
          (write-line "scenario,realm,kind,omega,amplitude,phase" peaks)
          (dolist (scenario (append *pair-scenarios* '(("chain-flat") ("chain-nested"))))
            (let* ((name (first scenario)) (parameters (rest scenario))
                   (chainp (search "chain-" name)) (nested (string= name "chain-nested"))
                   (max-error 0d0) (max-balance 0d0) (measurements nil))
              (loop for index from 0 to 30 for omega = (+ 0.5d0 (* 0.05d0 index))
                    do (let* ((factory (lambda (dt)
                                         (if chainp (chain-network dt omega :nested nested)
                                             (apply #'pair-network dt omega parameters))))
                              (result
                                (if (and nested (= index 10))
                                    (with-open-file (trace (merge-pathnames "nested-chain-trace.csv" directory)
                                                           :direction :output :if-exists :supersede)
                                      (measure-acoustic-response factory omega :trace-stream trace))
                                    (measure-acoustic-response factory omega)))
                              (reference (if chainp (chain-response omega) (pair-reference omega parameters)))
                              (error (distance (getf result :responses) reference)))
                         (push (cons omega result) measurements)
                         (setf max-error (max max-error error)
                               max-balance (max max-balance (getf result :scaled-residual)))
                         (validate (format nil "~A omega=~A analytical response" name omega) (< error 5d-6))
                         (validate (format nil "~A omega=~A work/loss balance" name omega)
                                   (< (getf result :scaled-residual) 1d-6))
                         (when (string= name "pair-off")
                           (validate "uncoupled receiver amplitude" (zerop (abs (aref (getf result :responses) 1)))))
                         (when (string= name "chain-flat") (setf (gethash index flat-results) result))
                         (when nested
                           (let* ((flat (gethash index flat-results))
                                  (difference (max (distance (getf flat :responses) (getf result :responses))
                                                   (abs (- (getf (getf flat :final) :work)
                                                           (getf (getf result :final) :work)))
                                                   (abs (- (getf (getf flat :final) :energy)
                                                           (getf (getf result :final) :energy))))))
                             (setf max-nesting-difference (max max-nesting-difference difference))
                             (validate "flat/nested controlled response and accounting equality" (zerop difference))))
                         (write-response responses name omega result reference)))
              (write-peaks peaks name (nreverse measurements))
              (format t "~A: 31 frequencies; max complex error=~,6E; max scaled energy residual=~,6E~%"
                      name max-error max-balance)))))
      (with-open-file (summary (merge-pathnames "transfer-summary.csv" directory) :direction :output :if-exists :supersede)
        (write-line "coupling,initial_energy,max_receiver_local_energy_fraction,first_10pct_crossing_time,max_relative_energy_drift" summary)
        (free-transfer directory summary #'validate))
      (format t "Flat/nested maximum response/accounting difference=~,6E~%" max-nesting-difference)
      (format t "VALIDATION: passed=~D failed=~D unexecuted=0~%" passed failed)
      (format t "~%INTERPRETATION~%")
      (if (zerop failed)
          (format t "The measured responses agree with the specified passive acoustic graph and independent analytical references.~%Containment labels alone add no physical effect in the matched graph control.~%")
          (format t "Some validations failed; retain the CSV measurements and investigate before claiming model recovery.~%"))
      (format t "These are normalized lumped acoustic simulations, not evidence of cognition, physical calibration, or unconnected interactions.~%")
      (when (plusp failed) (error "Experiment 002 failed ~D validations." failed))
      (values passed failed))))
