(defpackage #:sephirion-realm-tests
  (:use #:cl #:sephirion)
  (:import-from #:sephirion-experiment-001
                #:make-propagation #:make-interaction #:make-nested #:invalid-cases #:state-rows)
  (:export #:run-tests))
(in-package #:sephirion-realm-tests)

(defun permutations (items)
  (if (null items) (list nil)
      (loop for item in items append
            (mapcar (lambda (tail) (cons item tail))
                    (permutations (remove item items :test #'equal :count 1))))))

(defun run-tests ()
  (let ((passed 0) (failed 0))
    (labels ((check (condition label)
               (if condition (incf passed)
                   (progn (incf failed) (format t "FAIL realm check: ~A~%" label))))
             (rejects (thunk label)
               (check (handler-case (progn (funcall thunk) nil)
                        (model-error () t)) label)))
      (check (equal (state-rows (run-network (make-propagation) 1)) '((3 0) (3 7)))
             "affine numerical result")
      (check (equal (state-rows (run-network (make-interaction) 4))
                    '((1 0 0) (1 2 0) (1 4 6) (4 6 18) (13 14 36)))
             "multi-step recurrence")
      (check (equal (state-rows (run-network (make-nested) 3))
                    '((0 1 0) (0 1 1) (1 1 2) (3 1 3))) "nested latency")
      (check (equal (state-rows (run-network (make-interaction :bc-enabled nil) 4))
                    '((1 0 0) (1 2 0) (1 4 0) (1 6 0) (1 8 0))) "negative control")
      (let ((path (make-path "p" "x" "y" :operator :scale :gain -2/3 :enabled nil)))
        (check (= (transform-signal path 3/7) -2/7) "exact rational pure scale")
        (check (= (transform-signal path 3/7) (transform-signal path 3/7)) "pure repeatability"))
      ;; All 36 evaluation-order combinations are checked over four successive ticks.
      (let ((expected (network-history (run-network (make-interaction) 4))))
        (dolist (realm-order (permutations '("a" "b" "c")))
          (dolist (path-order (permutations '("ab" "bc" "ca")))
            (let ((network (make-interaction)))
              (dotimes (tick 4)
                (setf network (step-network network :realm-order realm-order :path-order path-order)))
              (check (equal (network-history network) expected) "order independence")))))
      (dotimes (replay 5)
        (check (equal (network-history (run-network (make-interaction) 10))
                      (network-history (run-network (make-interaction) 10))) "deterministic replay"))
      ;; A large intermediate sum must not create order-dependent rejection.
      (let* ((big (1- (expt 2 256)))
             (network (make-network (list (make-realm "a" :state big) (make-realm "b" :state big)
                                          (make-realm "c" :state (- big)) (make-realm "target"))
                                    (list (make-path "a" "a" "target")
                                          (make-path "b" "b" "target")
                                          (make-path "c" "c" "target")))))
        (dolist (order (permutations '("a" "b" "c")))
          (check (= (realm-state (step-network network :path-order order) "target") big)
                 "exact cancellation before final bound validation")))
      (let* ((realms (list (make-realm "b") (make-realm "a" :state 1)))
             (paths (list (make-path "z" "a" "b") (make-path "a" "b" "a"))))
        (check (equal (network-history (run-network (make-network realms paths) 3))
                      (network-history (run-network (make-network (reverse realms) (reverse paths)) 3)))
               "construction order independent"))
      (let* ((network (make-nested))
             (snapshot (network-snapshot network))
             (history (network-history network))
             (children (realm-children network "shell")))
        (setf (second (first (getf snapshot :states))) 999)
        (setf (char (first (first (getf (first history) :states))) 0) #\X)
        (setf (char (first children) 0) #\X)
        (check (= (realm-state network "input") 1) "snapshot ownership")
        (check (equal (realm-children network "shell") '("inner")) "child-ID ownership")
        (check (equal (network-history network) (network-history (make-nested))) "history ownership")
        (let ((successor (step-network network)))
          (check (= (network-tick network) 0) "old clock unchanged")
          (check (= (network-tick successor) 1) "clock increments")
          (check (= (realm-state network "shell") 0) "old state unchanged")
          (check (= (length (network-history successor)) 2) "initial plus committed history")))
      (let* ((id (copy-seq "a"))
             (declaration (make-realm id :state 2))
             (network (make-network (list declaration) nil)))
        (setf (char id 0) #\X)
        (check (= (realm-state network "a") 2) "constructor copies identifiers"))
      (let ((network (make-network (list (make-realm "shell" :state 5)
                                        (make-realm "child" :state 9 :parent "shell")) nil)))
        (check (equal (network-snapshot (run-network network 1))
                      '(:tick 1 :states (("child" 9) ("shell" 5))))
               "containment alone causes no signals or aggregation"))
      (let ((network (make-network (list (make-realm "shell" :state 5)
                                        (make-realm "child" :state 9 :parent "shell"))
                                  (list (make-path "up" "child" "shell")
                                        (make-path "down" "shell" "child")))))
        (check (equal (getf (network-snapshot (step-network network)) :states)
                      '(("child" 14) ("shell" 14))) "bidirectional boundary exchange reads old state"))
      (let ((network (make-network (list (make-realm "root" :state 1)
                                        (make-realm "shell")
                                        (make-realm "sub" :parent "shell")
                                        (make-realm "leaf" :parent "sub"))
                                  (list (make-path "a" "root" "shell")
                                        (make-path "b" "shell" "sub")
                                        (make-path "c" "sub" "leaf")))))
        (check (zerop (realm-state (run-network network 2) "leaf")) "deep nesting latency")
        (check (= (realm-state (run-network network 3) "leaf") 1) "recursive boundary traversal"))
      ;; Failure is transactional even when a different realm has a valid next state.
      (let* ((network (make-network (list (make-realm "a" :state 1)
                                         (make-realm "z" :state (expt 2 255)))
                                   (list (make-path "a" "a" "a") (make-path "z" "z" "z"))))
             (before (network-history network)))
        (rejects (lambda () (step-network network)) "candidate overflow rejects entire step")
        (check (and (= (network-tick network) 0) (= (realm-state network "a") 1)
                    (equal before (network-history network))) "failure leaves all old state/history intact"))
      (let* ((network (make-network (list (make-realm "a" :state (expt 2 255)))
                                   (list (make-path "p" "a" "a" :operator :scale :gain 2))))
             (before (network-history network)))
        (rejects (lambda () (step-network network)) "signal overflow rejects step")
        (check (equal before (network-history network)) "signal failure leaves history intact"))
      (dolist (case (invalid-cases)) (rejects (cdr case) (car case)))
      (rejects (lambda () (make-network nil nil)) "empty network")
      (rejects (lambda () (make-network (cons (make-realm "a") :tail) nil)) "improper list")
      (let ((circular (list (make-realm "a"))))
        (setf (cdr circular) circular)
        (rejects (lambda () (make-network circular nil)) "circular declaration list"))
      (rejects (lambda () (make-network (list (make-realm "a" :parent "a")) nil)) "self containment")
      (rejects (lambda () (make-realm "a" :state (/ 1 (expt 2 256)))) "denominator bound")
      (rejects (lambda () (realm-state (make-nested) "absent")) "unknown realm inspection")
      (rejects (lambda () (run-network :invalid 0)) "invalid network even at zero steps")
      (check (not (eq 'sephirion:run-experiment 'sephirion-experiment-001:run-experiment))
             "realm and acoustic experiment runners have distinct package symbols")
      (rejects (lambda () (step-network (make-interaction) :path-order '("ab"))) "partial path permutation")
      (check (= (realm-state (make-network (list (make-realm "a" :state -1/3)) nil) "a") -1/3)
             "signed rational initialization")
      (check (equal (network-history (run-network (make-nested) 0))
                    (network-history (make-nested))) "zero steps identity")
      (check (= (realm-state (step-network (make-network (list (make-realm "a" :state 3))
                                                        (list (make-path "self" "a" "a")))) "a") 6)
             "explicit self path")
      (check (= (realm-state (step-network (make-network (list (make-realm "a" :state 1))
                                                        (list (make-path "p" "a" "a" :enabled nil)))) "a") 1)
             "disabled path contributes zero"))
    (format t "Realm validation: passed=~D failed=~D unexecuted=0~%" passed failed)
    (when (plusp failed) (error "Realm tests failed."))
    t))
