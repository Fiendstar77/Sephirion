(defpackage #:sephirion-acoustic-tests
  (:use #:cl #:sephirion-acoustic)
  (:import-from #:sephirion-experiment-002 #:pair-network #:chain-network #:chain-response #:distance)
  (:export #:run-tests))
(in-package #:sephirion-acoustic-tests)

(defun energy-metrics (network steps)
  (let ((initial (acoustic-energy network)) (previous (acoustic-energy network))
        (max-drift 0d0) (max-increase 0d0) (max-residual 0d0) (scaled 0d0))
    (dotimes (tick steps)
      (setf network (step-acoustic network))
      (let* ((snapshot (acoustic-snapshot network)) (energy (getf snapshot :energy))
             (residual (abs (getf snapshot :residual))))
        (setf max-drift (max max-drift (/ (abs (- energy initial)) (max initial 1d-30)))
              max-increase (max max-increase (- energy previous))
              max-residual (max max-residual residual)
              scaled (max scaled (/ residual (+ 1d0 initial (abs (getf snapshot :work))
                                                (getf snapshot :dissipation))))
              previous energy)))
    (list :drift max-drift :increase max-increase :residual max-residual :scaled scaled
          :final-ratio (/ previous (max initial 1d-30)))))

(defun invalid-cases ()
  (list
   (cons "nonpositive inertance" (lambda () (make-acoustic-realm "a" :m 0)))
   (cons "negative inverse compliance" (lambda () (make-acoustic-realm "a" :k -1)))
   (cons "negative damping" (lambda () (make-acoustic-realm "a" :r -1)))
   (cons "negative coupling" (lambda () (make-coupling "p" "a" "b" -1)))
   (cons "complex state" (lambda () (make-acoustic-realm "a" :q #c(1 2))))
   (cons "invalid excitation" (lambda () (make-acoustic-realm "a" :amplitude "pressure")))
   (cons "negative drive frequency" (lambda () (make-acoustic-realm "a" :omega -1)))
   (cons "overflow-sized input" (lambda () (make-acoustic-realm "a" :m most-positive-double-float)))
   (cons "underflow-sized positive coefficient" (lambda () (make-acoustic-realm "a" :k 1d-200)))
   (cons "zero timestep" (lambda () (pair-network 0d0 1d0)))
   (cons "negative step count" (lambda () (run-acoustic (pair-network 0.02d0 1d0) -1)))
   (cons "self coupling" (lambda () (make-coupling "p" "a" "a" 1)))
   (cons "invalid enabled flag" (lambda () (make-coupling "p" "a" "b" 1 :enabled :yes)))
   (cons "missing endpoint" (lambda () (make-acoustic-network (list (make-acoustic-realm "a"))
                                                             (list (make-coupling "p" "a" "b" 1)))))
   (cons "duplicate realm IDs" (lambda () (make-acoustic-network
                                          (list (make-acoustic-realm "a") (make-acoustic-realm "a")) nil)))
   (cons "duplicate unordered coupling"
         (lambda () (make-acoustic-network (list (make-acoustic-realm "a") (make-acoustic-realm "b"))
                                           (list (make-coupling "p" "a" "b" 1)
                                                 (make-coupling "q" "b" "a" 1)))))
   (cons "missing parent" (lambda () (make-acoustic-network (list (make-acoustic-realm "a" :parent "b")) nil)))
   (cons "containment cycle" (lambda () (make-acoustic-network
                                        (list (make-acoustic-realm "a" :parent "b")
                                              (make-acoustic-realm "b" :parent "a")) nil)))
   (cons "disabled boundary bypass"
         (lambda () (make-acoustic-network
                     (list (make-acoustic-realm "a") (make-acoustic-realm "b")
                           (make-acoustic-realm "c" :parent "b"))
                     (list (make-coupling "p" "a" "c" 1 :enabled nil)))))
   (cons "directed path is not acoustic coupling"
         (lambda () (make-acoustic-network (list (make-acoustic-realm "a"))
                                           (list (sephirion:make-path "p" "a" "a")))))
   (cons "empty acoustic network" (lambda () (make-acoustic-network nil nil)))
   (cons "improper realm list" (lambda () (make-acoustic-network (cons (make-acoustic-realm "a") :tail) nil)))))

(defun run-tests ()
  (let ((passed 0) (failed 0) (*print-pretty* nil))
    (labels ((record (name ok observed limit)
               (if ok (incf passed) (incf failed))
               (format t "~A ~A observed=~S criterion=~S~%" (if ok "PASS" "FAIL") name observed limit))
             (below (name value limit) (record name (< value limit) value (list '< limit)))
             (rejects (name thunk)
               (let ((rejected (handler-case (progn (funcall thunk) nil)
                                 (sephirion:model-error () t))))
                 (record name rejected rejected :model-error))))
      (dolist (parameters '(nil (:m2 1.3d0 :k2 0.8d0 :r2 0.3d0)))
        (let ((network (apply #'pair-network 0.02d0 1.1d0 parameters))
              (pair (apply #'sephirion:make-acoustic-pair parameters))
              (state #(0d0 0d0 0d0 0d0)) (error 0d0))
          (dotimes (tick 1000)
            (setf state (sephirion:rk4-step pair state (* tick 0.02d0) 0.02d0 1.1d0 1d0)
                  network (step-acoustic network)
                  error (max error (distance state (subseq (acoustic-state network) 0 4)))))
          (below "pair transient recovery" error 1d-11)))
      (dolist (omega '(0.7d0 1d0 1.4d0 1.9d0))
        (let ((pair-result (measure-acoustic-response (lambda (dt) (pair-network dt omega)) omega))
              (chain-result (measure-acoustic-response (lambda (dt) (chain-network dt omega)) omega)))
          (multiple-value-bind (a b) (sephirion:analytical-response (sephirion:make-acoustic-pair) omega)
            (below "pair complex analytical response" (distance (getf pair-result :responses) (vector a b)) 5d-6))
          (below "chain modal analytical response" (distance (getf chain-result :responses) (chain-response omega)) 5d-6)))
      (let ((snapshot (acoustic-snapshot (run-acoustic (chain-network 0.02d0 1d0 :nested t :enabled nil) 2000))))
        (record "uncoupled nested isolation"
                (every (lambda (node) (and (zerop (getf node :q)) (zerop (getf node :v))))
                       (rest (getf snapshot :realms)))
                (mapcar (lambda (node) (list (getf node :q) (getf node :v))) (rest (getf snapshot :realms)))
                :exact-zero))
      (dolist (network (list (pair-network 0.02d0 0d0 :driven nil :q1 1d0 :r 0d0)
                             (chain-network 0.02d0 0d0 :driven nil :q1 1d0 :r 0d0)))
        (below "undriven undamped relative energy drift" (getf (energy-metrics network 5000) :drift) 1d-7))
      (let ((metrics (energy-metrics (chain-network 0.02d0 0d0 :driven nil :q1 1d0) 1000)))
        (below "passive per-step energy increase" (getf metrics :increase) 1d-12)
        (below "passive final energy fraction at t=20" (getf metrics :final-ratio) 0.03d0))
      (let ((metrics (energy-metrics (chain-network 0.02d0 1d0) 10000)))
        (below "driven input-work/dissipation balance" (getf metrics :scaled) 1d-6))
      ;; Independent energy directional derivative, including equal/opposite edge work.
      (let* ((network (make-acoustic-network
                       (list (make-acoustic-realm "a" :q 0.3d0 :v -0.1d0 :r 0.2d0 :amplitude 1d0 :omega 1d0)
                             (make-acoustic-realm "b" :q -0.2d0 :v 0.5d0 :r 0.2d0)
                             (make-acoustic-realm "c" :q 0.4d0 :v 0.2d0 :r 0.2d0))
                       (list (make-coupling "ab" "a" "b" 0.5d0) (make-coupling "bc" "b" "c" 0.5d0))))
             (state (acoustic-state network))
             (derivative (sephirion-acoustic::derivative network state 0d0))
             (eps 1d-6)
             (plus (sephirion::shifted-state state derivative eps))
             (minus (sephirion::shifted-state state derivative (- eps)))
             (gradient (/ (- (nth-value 2 (sephirion-acoustic::energy-parts network plus))
                             (nth-value 2 (sephirion-acoustic::energy-parts network minus))) (* 2d0 eps)))
             (expected (- -0.1d0 (* 0.2d0 (+ 0.01d0 0.25d0 0.04d0)))))
        (below "independent energy derivative equals pressure work minus loss" (abs (- gradient expected)) 1d-8))
      (let ((errors
              (loop for dt in '(0.08d0 0.04d0)
                    for steps in '(125 250)
                    for network = (make-acoustic-network
                                   (list (make-acoustic-realm "a" :q 1d0)
                                         (make-acoustic-realm "b" :q 1d0))
                                   (list (make-coupling "ab" "a" "b" 0.5d0)) :dt dt)
                    collect (distance (subseq (acoustic-state (run-acoustic network steps)) 0 4)
                                      (vector (cos 10d0) (- (sin 10d0)) (cos 10d0) (- (sin 10d0)))))))
        (record "fourth-order state refinement" (> (/ (first errors) (second errors)) 12d0)
                (/ (first errors) (second errors)) '(> 12d0)))
      (let* ((coarse (getf (energy-metrics (chain-network 0.08d0 1d0) 250) :residual))
             (fine (getf (energy-metrics (chain-network 0.04d0 1d0) 500) :residual)))
        (record "driven balance refinement" (> (/ coarse fine) 8d0) (/ coarse fine) '(> 8d0)))
      (let ((short (measure-acoustic-response (lambda (dt) (pair-network dt 1d0 :r 0.1d0)) 1d0))
            (long (measure-acoustic-response (lambda (dt) (pair-network dt 1d0 :r 0.1d0)) 1d0 :settle-time 600d0)))
        (below "least-damped settling-window comparison" (distance (getf short :responses) (getf long :responses)) 5d-6))
      (let ((flat (chain-network 0.02d0 1d0)) (nested (chain-network 0.02d0 1d0 :nested t))
            (replay (chain-network 0.02d0 1d0)) (error 0d0) (same t))
        (dotimes (tick 5000)
          (setf flat (step-acoustic flat) nested (step-acoustic nested) replay (step-acoustic replay)
                error (max error (distance (acoustic-state flat) (acoustic-state nested)))
                same (and same (equalp (acoustic-snapshot flat) (acoustic-snapshot replay)))))
        (record "flat/nested entire physical trajectory" (zerop error) error :exact-zero)
        (record "deterministic complete snapshot replay" same same t))
      (let* ((network (pair-network 0.02d0 1d0)) (before (acoustic-snapshot network))
             (state (acoustic-state network)) (snapshot (acoustic-snapshot network)))
        (setf (aref state 0) 999d0 (getf (first (getf snapshot :realms)) :q) 999d0)
        (step-acoustic network)
        (record "predecessor and returned-state isolation" (equalp before (acoustic-snapshot network)) t t))
      (let* ((snapshot (acoustic-snapshot (pair-network 0.02d0 0d0 :q1 1d0 :r 0d0 :driven nil)))
             (nodes (getf snapshot :realms)))
        (record "explicit initial local and shared spring energy"
                (and (= (getf snapshot :energy) 0.75d0)
                     (= (getf (first nodes) :local-energy) 0.5d0)
                     (= (getf (second nodes) :local-energy) 0d0)
                     (= (getf (first nodes) :energy) 0.625d0)
                     (= (getf (second nodes) :energy) 0.125d0))
                (mapcar (lambda (node) (getf node :energy)) nodes) '(0.625d0 0.125d0)))
      (let* ((nodes (list (make-acoustic-realm "a" :r 0.2d0 :amplitude 1d0 :omega 1d0)
                          (make-acoustic-realm "b" :r 0.2d0 :omega 1d0)))
             (forward (make-acoustic-network nodes (list (make-coupling "ab" "a" "b" 0.5d0))))
             (reverse (make-acoustic-network (reverse nodes) (list (make-coupling "ab" "b" "a" 0.5d0)))))
        (record "canonical declaration and endpoint ordering"
                (equalp (acoustic-state (run-acoustic forward 1000))
                        (acoustic-state (run-acoustic reverse 1000))) t t))
      (let* ((network (make-acoustic-network
                       (list (make-acoustic-realm "a" :amplitude 2d0 :omega 0d0)) nil :dt (/ pi 1000d0)))
             (state (acoustic-state (run-acoustic network 1000))))
        (below "constant excitation exact single-oscillator response"
               (distance (subseq state 0 2) #(4d0 0d0)) 1d-9))
      (let* ((network (make-acoustic-network
                       (list (make-acoustic-realm "a" :q 1d100 :m 1d-100 :k 1d100)) nil :dt 1d0))
             (before (acoustic-snapshot network)))
        (rejects "integration overflow rejected" (lambda () (step-acoustic network)))
        (record "failed step is transactional" (equalp before (acoustic-snapshot network)) t t))
      (dolist (case (invalid-cases)) (rejects (car case) (cdr case))))
    (format t "Acoustic-network validation: passed=~D failed=~D unexecuted=0~%" passed failed)
    (when (plusp failed) (error "Acoustic-network tests failed."))
    t))
