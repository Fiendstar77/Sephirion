(defpackage #:sephirion-tests (:use #:cl #:sephirion))
(in-package #:sephirion-tests)

(defun evolve (pair initial dt steps)
  (loop with state = initial for tick below steps
        do (setf state (rk4-step pair state (* tick dt) dt 0d0 0d0))
        finally (return state)))

(defun run-tests ()
  (let ((checks 0))
    (flet ((check (condition label)
             (unless condition (error "Failed: ~A" label))
             (incf checks)))
      ;; A disconnected second resonator stays at rest despite matching frequencies.
      (let ((pair (make-acoustic-pair :coupling 0d0)))
        (multiple-value-bind (q1 q2) (measure-response pair 1d0)
          (check (zerop (abs q2)) "no excitation without coupling")
          (check (< (abs (- q1 #c(0d0 -5d0))) 1d-6)
                 "isolated resonant response and phase")))
      ;; Includes asymmetric coefficients to expose matrix/sign/index mistakes.
      (dolist (pair (list (make-acoustic-pair)
                         (make-acoustic-pair :m2 1.3d0 :k2 0.8d0 :r2 0.3d0)))
        (dolist (omega '(0.7d0 1d0 1.4d0 1.9d0))
          (multiple-value-bind (q1 q2) (measure-response pair omega)
            (multiple-value-bind (a1 a2) (analytical-response pair omega)
              (check (< (max (abs (- q1 a1)) (abs (- q2 a2))) 1d-6)
                     "numerical amplitude and phase agree with analytical response")))))
      (let* ((pair (make-acoustic-pair :r1 0d0 :r2 0d0))
             (initial #(1d0 0d0 0d0 0d0))
             (energy (stored-energy pair initial))
             (final (evolve pair initial 0.01d0 10000)))
        (check (< (/ (abs (- (stored-energy pair final) energy)) energy) 1d-8)
               "unforced undamped energy conservation")
        (check (> (abs (aref (evolve pair initial 0.01d0 300) 2)) 0.1d0)
               "coupling transfers excitation"))
      (let* ((pair (make-acoustic-pair)) (state #(1d0 0d0 0d0 0d0))
             (initial-energy (stored-energy pair state)))
        (dotimes (tick 2000)
          (let ((next (rk4-step pair state (* tick 0.01d0) 0.01d0 0d0 0d0)))
            (check (<= (stored-energy pair next) (+ (stored-energy pair state) 1d-12))
                   "passive energy decreases each step")
            (setf state next)))
        (check (< (stored-energy pair state) (* 0.03d0 initial-energy))
               "damping removes energy"))
      ;; Independent directional derivative of E must match pressure work minus loss.
      (let* ((pair (make-acoustic-pair :m2 1.3d0 :k2 0.8d0))
             (state #(0.3d0 -0.7d0 0.2d0 0.4d0))
             (derivative (pair-derivative pair state 0.4d0 1.1d0 0.8d0))
             (epsilon 1d-5)
             (plus (map 'vector (lambda (x dx) (+ x (* epsilon dx))) state derivative))
             (minus (map 'vector (lambda (x dx) (- x (* epsilon dx))) state derivative)))
        (multiple-value-bind (input loss net) (power-balance pair state 0.4d0 1.1d0 0.8d0)
          (declare (ignore input loss))
          (check (< (abs (- (/ (- (stored-energy pair plus) (stored-energy pair minus))
                              (* 2d0 epsilon)) net)) 1d-9)
                 "energy derivative equals supplied minus dissipated power")))
      ;; Exact in-phase mode q1=q2=cos(t), u1=u2=-sin(t).
      (let* ((pair (make-acoustic-pair :r1 0d0 :r2 0d0))
             (initial #(1d0 0d0 1d0 0d0))
             (exact (vector (cos 10d0) (- (sin 10d0)) (cos 10d0) (- (sin 10d0))))
             (coarse (evolve pair initial 0.2d0 50))
             (fine (evolve pair initial 0.1d0 100))
             (coarse-error (reduce #'max (map 'vector (lambda (a b) (abs (- a b))) coarse exact)))
             (fine-error (reduce #'max (map 'vector (lambda (a b) (abs (- a b))) fine exact))))
        (check (> (/ coarse-error fine-error) 14d0) "fourth-order timestep convergence"))
      (let ((pair (make-acoustic-pair)))
        (multiple-value-bind (normal1 normal2) (measure-response pair 1.4d0)
          (multiple-value-bind (long1 long2)
              (measure-response pair 1.4d0 :settle-time 300d0)
            (check (< (max (abs (- normal1 long1)) (abs (- normal2 long2))) 1d-8)
                   "reference settling window removes transients")))
        (multiple-value-bind (a1 a2) (analytical-response pair 1.4d0)
          (let ((errors
                  (loop for dt in '(0.04d0 0.02d0)
                        collect (multiple-value-bind (q1 q2)
                                    (measure-response pair 1.4d0 :max-dt dt :settle-time 300d0)
                                  (max (abs (- q1 a1)) (abs (- q2 a2)))))))
            (check (> (/ (first errors) (second errors)) 14d0)
                   "driven response converges at fourth order"))))
      (check (handler-case
                 (progn (analytical-response
                         (make-acoustic-pair :r1 0d0 :r2 0d0 :coupling 0d0) 1d0) nil)
               (error () t)) "reject singular undamped steady response")
      (dolist (arguments '((:m1 0) (:r1 -1) (:k2 -1) (:coupling -1)))
        (check (handler-case (progn (apply #'make-acoustic-pair arguments) nil)
                 (error () t)) "reject nonpassive or invalid coefficients")))
    (format t "~D acoustic checks passed.~%" checks)
    t))
